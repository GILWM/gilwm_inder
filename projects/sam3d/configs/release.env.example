# Source this file after replacing the example paths. Bash 4+ is required.
export COSMOS_PROJECT=/path/to/gilwm_inder
export COSMOS_SAM3D_WORKSPACE=/path/to/runtime-workspace
export COSMOS_MUSA_IMAGE=your-accessible-musa-runtime-image
export SAM3D_DATASET_ROOT=/path/to/training-dataset
export SAM3D_CACHE_ROOT=/path/to/sam3-cache
export SAM3D_OBJECTS_ROOT=/path/to/sam3d-sidecars
export SAM3D_NATIVE_INDEX=/path/to/matching-frozen-whitelist.txt
export SAM3D_BASE_CHECKPOINT=/path/to/initialization/model_ema_bf16.pt
export ACTION_NORM_PATH=/path/to/action_norm_stats.npz
export MASTER_ADDR=your-rendezvous-host
# Set MCCL_SOCKET_IFNAME, MCCL_IB_HCA and other MCCL options for your cluster.
# Extra dataset/trajectory resources outside the roots above:
export COSMOS_EXTRA_BIND_PATHS=/path/to/raw-videos:/path/to/action-hdf5
# Optional migrated symlink mounts: source=destination;source=destination
export COSMOS_EXTRA_BIND_MOUNTS=
